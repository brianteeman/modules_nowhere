<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="rule">
		<field
			name="menuitem"
			type="menuitem"
			label="PLG_SYSTEM_MODULESNOWHERE_FIELD_MENUITEM_LABEL"
			description="PLG_SYSTEM_MODULESNOWHERE_FIELD_MENUITEM_DESC"
			published="1"
			client_id="0"
			required="true"
		/>
		<field
			name="modules"
			type="sql"
			label="PLG_SYSTEM_MODULESNOWHERE_FIELD_MODULES_LABEL"
			description="PLG_SYSTEM_MODULESNOWHERE_FIELD_MODULES_DESC"
			query="SELECT id, CONCAT(title, ' (', id, ')') AS module_title FROM #__modules WHERE client_id = 0 AND published = 1 ORDER BY title"
			key_field="id"
			value_field="module_title"
			multiple="true"
			filter="intarray"
			layout="joomla.form.field.list-fancy-select"
		/>
		<field
			name="positions"
			type="subform"
			label="PLG_SYSTEM_MODULESNOWHERE_FIELD_POSITIONS_LABEL"
			description="PLG_SYSTEM_MODULESNOWHERE_FIELD_POSITIONS_DESC"
			formsource="plugins/system/modulesnowhere/forms/position.xml"
			multiple="true"
			layout="joomla.form.field.subform.repeatable"
			min="0"
			max="50"
			buttons="add,remove,move"
		/>
	</fieldset>
</form>
