<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_modulesnowhere</name>
	<version>1.0.0</version>
	<description>PLG_SYSTEM_MODULESNOWHERE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\System\ModulesNowhere</namespace>
	<files>
		<folder plugin="modulesnowhere">services</folder>
		<folder>src</folder>
		<folder>forms</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_modulesnowhere.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_modulesnowhere.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="rules" label="PLG_SYSTEM_MODULESNOWHERE_FIELDSET_RULES">
				<field
					name="rules"
					type="subform"
					label="PLG_SYSTEM_MODULESNOWHERE_RULES_LABEL"
					description="PLG_SYSTEM_MODULESNOWHERE_RULES_DESC"
					formsource="plugins/system/modulesnowhere/forms/rule.xml"
					multiple="true"
					layout="joomla.form.field.subform.repeatable-table"
					min="0"
					max="100"
					buttons="add,remove,move"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
